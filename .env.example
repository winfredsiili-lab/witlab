# Copy this file to apps/api/.env and fill in real values. Never commit the real file.

# API
PORT=4000
NODE_ENV=development
# Origin allowed to call the API from a browser (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 15 or newer (example for a local install)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/witlab

# Authentication. "password" (default) = real accounts: register, then sign in with email + password.
# "dev-stub" makes every request act as one seeded development user with NO sign-in.
# dev-stub is DEVELOPMENT ONLY: the server refuses to start with it when NODE_ENV=production.
AUTH_MODE=password
# Only used by AUTH_MODE=dev-stub.
DEV_USER_EMAIL=dev@witlab.local
# Set to false once your own account exists if the server is reachable by anyone else.
ALLOW_REGISTRATION=true
# How long a sign-in lasts, in days (1-365).
SESSION_DAYS=30

# Integration tests only. The database name MUST end in _test (tests refuse to run otherwise).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/witlab_test

# Manual browser walk-through only (npm run e2e). Set it in the shell, not in the API's .env.
# The database name MUST end in _e2e: the script empties its decks, cards and sources.
# E2E_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/witlab_e2e

# AI card generation (backend only; never put this key in the web app). See docs/AI_PROVIDER.md.
# Without AI_API_KEY the app works normally and "Generate cards" says generation is not set up.
# Default provider is Groq's free tier: create a key at https://console.groq.com/keys
# AI_API_KEY=
# Any OpenAI-compatible endpoint works. These are the defaults:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_STRICT_SCHEMA=true          # false for models without strict JSON schema support
# AI_REASONING_EFFORT=low        # low | medium | high | off (off for models that reject the parameter)
# AI_TIMEOUT_MS=45000
# GENERATION_DAILY_LIMIT=20          # per user per rolling 24 hours
# GENERATION_GLOBAL_DAILY_LIMIT=500  # all users; keep below the provider's daily request limit
# EVALUATION_DAILY_LIMIT=60          # AI-judged written answers per user per rolling 24 hours (failed attempts count)
# EVALUATION_GLOBAL_DAILY_LIMIT=300  # all users; generation + evaluation should stay under the provider's daily limit
